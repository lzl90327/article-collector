{
  "phase": {
    "id": 2,
    "name": "Discussion",
    "name_cn": "乒乓球探讨",
    "description": "苏格拉底式对话，发散/深化论证",
    "type": "standard"
  },
  "entry": {
    "triggers": [
      "继续探讨",
      "深入一下",
      "帮我理清思路",
      "苏格拉底一下"
    ],
    "condition": "angle_pool.selected_angle"
  },
  "exit": {
    "condition": "user_says_converge || discussion_rounds >= 5",
    "next_phase": 3
  },
  "fields": {
    "discussion_history": {
      "name": "对话历史",
      "description": "多轮对话记录",
      "type": "array",
      "required": false
    },
    "key_insights": {
      "name": "关键洞见",
      "description": "对话中产生的核心洞察",
      "type": "array",
      "required": false
    },
    "open_questions": {
      "name": "开放问题",
      "description": "尚未解决的问题",
      "type": "array",
      "required": false
    }
  },
  "interaction": {
    "substates": ["idle", "await_free_text"],
    "pending_input": "free_discussion",
    "prompt_template": "socratic_dialogue",
    "actions": [
      {
        "key": "continue",
        "label": "继续",
        "description": "继续对话",
        "next_substate": "await_free_text"
      },
      {
        "key": "converge",
        "label": "收一下",
        "description": "结束对话，进入内容收敛",
        "next_substate": "converging"
      },
      {
        "key": "pause",
        "label": "暂停",
        "description": "暂停当前话题",
        "next_substate": "paused"
      }
    ]
  },
  "artifact": {
    "type": "discussion_log",
    "fields": ["discussion_history", "key_insights", "open_questions"],
    "versioned": false
  },
  "model_config": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "temperature": 0.9,
    "json_mode": false
  },
  "created_at": "2026-02-19T10:00:00Z",
  "updated_at": "2026-02-19T10:00:00Z"
}
