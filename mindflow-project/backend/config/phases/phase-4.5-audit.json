{
  "phase": {
    "id": 4.5,
    "name": "Audit",
    "name_cn": "编辑审阅",
    "description": "DeepSeek 6 维度深度审阅",
    "type": "standard"
  },
  "entry": {
    "triggers": [
      "深度审校",
      "编辑看看",
      "审阅一下",
      "进入审阅流程"
    ],
    "condition": "draft.generated === true"
  },
  "exit": {
    "condition": "review_rounds >= 3 || (dimensions_passed >= 4 && overall_score >= 7)",
    "next_phase": 4.8
  },
  "fields": {
    "dimensions": {
      "name": "审阅维度",
      "description": "6 维度审阅结果",
      "type": "array",
      "required": true,
      "items": [
        {
          "name": "LogicJudge",
          "description": "逻辑判官",
          "score": "0-10",
          "issues": ["逻辑问题"]
        },
        {
          "name": "FactChecker",
          "description": "事实核验员",
          "score": "0-10",
          "risk_level": "low/medium/high",
          "issues": ["事实问题"]
        },
        {
          "name": "EmotionalHacker",
          "description": "情绪黑客",
          "score": "0-10",
          "metrics": {
            "curiosity": "好奇心",
            "resonance": "共鸣感",
            "surprise": "意外感",
            "credibility": "可信度",
            "actionability": "行动欲"
          },
          "forbidden_words": ["禁用词"]
        },
        {
          "name": "Dissenter",
          "description": "异见领袖",
          "score": "0-10",
          "counter_arguments": ["反对意见"]
        },
        {
          "name": "StructureAnalyst",
          "description": "结构分析师",
          "score": "0-10",
          "issues": ["结构问题"]
        },
        {
          "name": "GrammarEditor",
          "description": "语法编辑",
          "score": "0-10",
          "issues": ["语法问题"]
        }
      ]
    },
    "overall_score": {
      "name": "总体评分",
      "description": "综合评分",
      "type": "number",
      "required": true
    },
    "revision_suggestions": {
      "name": "修订建议",
      "description": "具体修订建议",
      "type": "array",
      "required": true
    }
  },
  "interaction": {
    "substates": ["reviewing", "await_revision", "completed"],
    "pending_input": "revision_choice",
    "prompt_template": "audit_report",
    "actions": [
      {
        "key": "revise",
        "label": "继续修订",
        "description": "根据建议修改",
        "next_substate": "await_revision"
      },
      {
        "key": "images",
        "label": "去配图",
        "description": "审阅通过，去配图",
        "condition": "dimensions_passed >= 4",
        "next_phase": 4.8
      },
      {
        "key": "back_research",
        "label": "补充资讯",
        "description": "论据不足，需要补充",
        "next_phase": 0.5
      },
      {
        "key": "back_converge",
        "label": "重新收敛",
        "description": "结构问题，需要重新收敛",
        "next_phase": 3
      }
    ]
  },
  "mcp_services": [
    {
      "name": "cyber-editorial",
      "description": "赛博编辑部 v2.5 - 6 维度审阅"
    }
  ],
  "artifact": {
    "type": "review_report",
    "fields": ["dimensions", "overall_score", "revision_suggestions", "round"],
    "versioned": true
  },
  "model_config": {
    "provider": "deepseek",
    "model": "deepseek-reasoner",
    "temperature": 0.6,
    "json_mode": true
  },
  "created_at": "2026-02-19T10:00:00Z",
  "updated_at": "2026-02-19T10:00:00Z"
