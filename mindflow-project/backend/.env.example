# MindFlow 后端环境变量模板
# 复制此文件为 .env 并填写实际值

# 数据库配置
DATABASE_URL="postgresql://user:password@localhost:5432/mindflow"
# 或使用 Supabase
# DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# JWT 密钥
JWT_SECRET="your-super-secret-jwt-key-min-32-characters"

# 微信小程序配置
WECHAT_APPID="your-wechat-miniprogram-appid"
WECHAT_SECRET="your-wechat-miniprogram-secret"

# Feishu 飞书配置
FEISHU_APP_ID="your-feishu-app-id"
FEISHU_APP_SECRET="your-feishu-app-secret"
FEISHU_ENCRYPT_KEY="your-feishu-encrypt-key"

# Coze 配置
COZE_API_KEY="your-coze-api-key"
COZE_BOT_ID="your-coze-bot-id"

# AI 模型配置
DEEPSEEK_API_KEY="your-deepseek-api-key"
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# 服务器配置
PORT=3000
NODE_ENV="development"

# 日志级别
LOG_LEVEL="info"
