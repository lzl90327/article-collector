# MindFlow 后端环境变量模板
# 复制此文件为 .env 并填写实际值

# ============================================
# 数据库配置 (必填)
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/mindflow"
# 或使用 Supabase
# DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ============================================
# JWT 密钥 (必填)
# ============================================
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# ============================================
# 微信小程序配置 (必填)
# ============================================
WECHAT_APPID="your-wechat-miniprogram-appid"
WECHAT_SECRET="your-wechat-miniprogram-secret"

# ============================================
# Feishu 飞书配置 (素材同步和文章发布)
# ============================================
# 应用凭证
FEISHU_APP_ID="your-feishu-app-id"
FEISHU_APP_SECRET="your-feishu-app-secret"
FEISHU_ENCRYPT_KEY="your-feishu-encrypt-key"

# --- 素材库配置 (按类型分库) ---
# 文章素材库
FEISHU_ARTICLE_SOURCES_TOKEN="your-article-sources-bitable-token"
FEISHU_ARTICLE_SOURCES_TABLE_ID="your-article-sources-table-id"

# 视频素材库
FEISHU_VIDEO_SOURCES_TOKEN="your-video-sources-bitable-token"
FEISHU_VIDEO_SOURCES_TABLE_ID="your-video-sources-table-id"

# 音频素材库
FEISHU_AUDIO_SOURCES_TOKEN="your-audio-sources-bitable-token"
FEISHU_AUDIO_SOURCES_TABLE_ID="your-audio-sources-table-id"

# 图片素材库
FEISHU_IMAGE_SOURCES_TOKEN="your-image-sources-bitable-token"
FEISHU_IMAGE_SOURCES_TABLE_ID="your-image-sources-table-id"

# 图书素材库
FEISHU_BOOK_SOURCES_TOKEN="your-book-sources-bitable-token"
FEISHU_BOOK_SOURCES_TABLE_ID="your-book-sources-table-id"

# 论文素材库
FEISHU_PAPER_SOURCES_TOKEN="your-paper-sources-bitable-token"
FEISHU_PAPER_SOURCES_TABLE_ID="your-paper-sources-table-id"

# --- 其他库 ---
FEISHU_VIEWPOINTS_BITABLE_TOKEN="your-viewpoints-bitable-token"
FEISHU_IDEAS_BITABLE_TOKEN="your-ideas-bitable-token"

# --- 知识库配置 ---
FEISHU_ARTICLE_WIKI_SPACE_ID="your-article-wiki-space-id"
FEISHU_DIALOGUE_WIKI_SPACE_ID="your-dialogue-wiki-space-id"
FEISHU_WEEKLY_WIKI_SPACE_ID="your-weekly-wiki-space-id"

# 文章库 (用于发布同步)
FEISHU_ARTICLE_LIBRARY_SPACE_ID="your-article-library-space-id"
FEISHU_ARTICLE_LIBRARY_FOLDER_TOKEN="your-article-library-folder-token"

# ============================================
# Coze 配置 (AI 审阅)
# ============================================
COZE_API_KEY="your-coze-api-key"
COZE_BOT_ID="your-coze-bot-id"

# ============================================
# AI 模型配置 (可选)
# ============================================
DEEPSEEK_API_KEY="your-deepseek-api-key"
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ============================================
# 服务器配置
# ============================================
PORT=3000
NODE_ENV="development"

# 日志级别: debug, info, warn, error
LOG_LEVEL="info"

# ============================================
# 其他配置
# ============================================
# 请求超时时间 (毫秒)
REQUEST_TIMEOUT=30000

# 同步任务间隔 (分钟)
SYNC_INTERVAL=30
