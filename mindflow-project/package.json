{
  "name": "mindflow",
  "version": "1.0.0",
  "description": "AI 驱动的智能写作工作流系统",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev:weapp",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build:weapp",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test": "npm run test:backend && npm run test:frontend",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "axios": "^1.13.5",
    "chalk": "^5.6.2",
    "dotenv": "^17.3.1"
  }
}
