# 飞书应用配置（必填）
LARK_APP_ID=cli_xxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxx

# 知识库配置（必填）
WIKI_SPACE_ID=xxxxxxxx
# 父节点 token，留空则添加到知识库根目录
WIKI_PARENT_NODE_TOKEN=

# 多维表格配置（必填）
BITABLE_APP_TOKEN=xxxxxxxx
BITABLE_TABLE_ID=tblxxxxxxxx

# 多维表格字段名称配置
FIELD_TITLE=标题
FIELD_AUTHOR=作者
FIELD_PUBLISH_TIME=发布时间
FIELD_SOURCE=来源
FIELD_ORIGINAL_URL=原文链接
FIELD_SUMMARY=摘要
FIELD_DOC_URL=文档链接
FIELD_COLLECT_TIME=收藏时间

# 可选配置
# Jina Reader API Key（可选，增加配额）
JINA_API_KEY=

# 日志级别：debug, info, warn, error
LOG_LEVEL=info
