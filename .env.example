# 飞书应用配置（必填）
LARK_APP_ID=cli_xxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxx

# 知识库配置（必填）
WIKI_SPACE_ID=xxxxxxxx
# 父节点 token，留空则添加到知识库根目录
WIKI_PARENT_NODE_TOKEN=

# 多维表格配置（必填）
BITABLE_APP_TOKEN=xxxxxxxx
BITABLE_TABLE_ID=tblxxxxxxxx

# 多维表格字段名称配置
FIELD_TITLE=标题
FIELD_AUTHOR=作者
FIELD_PUBLISH_TIME=发布时间
FIELD_SOURCE=来源
FIELD_ORIGINAL_URL=原文链接
FIELD_SUMMARY=摘要
FIELD_DOC_URL=文档链接
FIELD_COLLECT_TIME=收藏时间

# ========== 碎片想法库配置（可选） ==========
# 想法多维表格 app_token 和 table_id
IDEAS_BITABLE_APP_TOKEN=
IDEAS_BITABLE_TABLE_ID=

# 想法库字段名称配置（可选，使用默认值）
IDEA_FIELD_CONTENT=文本
IDEA_FIELD_TIME=记录时间
IDEA_FIELD_INPUT_TYPE=输入方式
IDEA_FIELD_SCENE=来源场景
IDEA_FIELD_EMOTION=情绪标签
IDEA_FIELD_RELATED_URL=关联素材
IDEA_FIELD_RELATED_TITLE=关联素材标题
IDEA_FIELD_VOICE_DURATION=语音时长
IDEA_FIELD_TOPICS=主题标签
IDEA_FIELD_MATURITY=成熟度
IDEA_FIELD_SUMMARIZED=已汇总

# ========== DeepSeek LLM 配置（可选） ==========
# DeepSeek API Key，用于智能消息分类
DEEPSEEK_API_KEY=

# ========== 百度语音识别配置（可选） ==========
# 百度千帆 ASR API 凭证
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=

# ========== 小红书提取配置 ==========
# XHS-Downloader API 服务地址（推荐方案）
# 需要先启动 XHS-Downloader: cd XHS-Downloader && uv run main.py api
XHS_API_URL=http://127.0.0.1:5556

# ========== 百度 OCR 配置（图片识别/运动截图） ==========
# 百度千帆 qianfan-ocr 模型 API Key
# 格式：bce-v3/ALTAK-xxx/xxx
BAIDU_OCR_API_KEY=

# ========== COROS 运动记录配置（可选） ==========
# 启用运动截图识别功能
COROS_ENABLED=false
# COROS 专用飞书应用凭证（如使用独立应用访问 COROS 多维表格）
# 不填则使用主应用凭证
COROS_LARK_APP_ID=
COROS_LARK_APP_SECRET=
# 运动记录多维表格配置
COROS_BITABLE_APP_TOKEN=
COROS_BITABLE_TABLE_ID=
# 运动记录字段名称配置（可选，使用默认值）
COROS_FIELD_DATE=运动日期
COROS_FIELD_SPORT=运动项目
COROS_FIELD_RUN_KM=跑步距离
COROS_FIELD_RIDE_KM=骑行距离
COROS_FIELD_ELEV_M=爬升高度
COROS_FIELD_NOTES=备注
COROS_FIELD_SOURCE=数据源
COROS_FIELD_RAW=原始凭证
COROS_FIELD_CONF=置信度
COROS_FIELD_DEDUPE=去重键

# ========== 多维表格扩展字段（小红书支持） ==========
# 这些字段需要在飞书多维表格中手动创建
FIELD_CONTENT_TYPE=内容类型
FIELD_IMAGE_COUNT=图片数量

# ========== Redis 配置 ==========
# Redis 连接 URL（用于知识提炼队列）
REDIS_URL=redis://127.0.0.1:6379

# ========== 知识提炼功能开关 ==========
# 启用智能要点提取和深度分析功能
REFINERY_ENABLED=true

# ========== 可选配置 ==========
# Jina Reader API Key（可选，增加配额）
JINA_API_KEY=

# 日志级别：debug, info, warn, error
LOG_LEVEL=info
